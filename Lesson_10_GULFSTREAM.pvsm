        <Proxy value="12780" output_port="0"/>
        <Domain name="groups" id="13064.Input.groups"/>
        <Domain name="input_type" id="13064.Input.input_type"/>
      </Property>
      <Property name="OutputDataSetType" id="13064.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="enum" id="13064.OutputDataSetType.enum">
          <Entry value="8" text="Same as Input"/>
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="10" text="vtkUniformGrid"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="32" text="vtkHyperTreeGrid"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="13064.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="13064.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;from vtkmodules.vtkCommonDataModel import vtkCellArray&#xa;&#xa;# Particle Tracer output: points only, no cells, plus one value per particle in these arrays&#xa;seed = inputs[0].PointData[&#x27;InjectedPointId&#x27;]   # which seed point released the particle (0, 1, ...)&#xa;age  = inputs[0].PointData[&#x27;ParticleAge&#x27;]       # how long the particle has travelled (days)&#xa;&#xa;# vtkCellArray holds the connectivity: which point ids make up each cell (here: each line)&#xa;lines = vtkCellArray()&#xa;&#xa;# np.unique(seed) gives each seed id once, e.g. [0, 1, 2, 3], so we build one streakline per seed point&#xa;for s in np.unique(seed):&#xa;    ids = np.where(seed == s)[0]           # point ids of all particles from this seed point ...&#xa;    ids = ids[np.argsort(age[ids])]        # ... sorted from youngest (at the seed) to oldest&#xa;    lines.InsertNextCell(len(ids))         # start a new line cell that will have len(ids) points&#xa;    # add the point ids to this line in sorted order; VTK expects plain Python int, not numpy int&#xa;    for i in ids:&#xa;        lines.InsertCellPoint(int(i))&#xa;&#xa;output.ShallowCopy(inputs[0].VTKObject)    # keep the particles and their arrays (no data copy)&#xa;output.SetLines(lines)                     # and add one line per seed point&#xa;"/>
      </Property>
